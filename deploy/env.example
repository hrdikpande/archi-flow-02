# DrawingOps environment. `make env` copies this to ../.env for local development.
# Never commit .env. In staging/production use the host's secret store.

DJANGO_ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
FRONTEND_URL=http://127.0.0.1:8080

POSTGRES_DB=drawingops
POSTGRES_USER=drawingops
POSTGRES_PASSWORD=drawingops
DATABASE_URL=postgres://drawingops:drawingops@postgres:5432/drawingops

CELERY_BROKER_URL=redis://valkey:6379/0
CACHE_URL=redis://valkey:6379/1

# S3-compatible object storage (SeaweedFS in development; see docs/06 R-01).
S3_BUCKET=drawingops
S3_REGION=ap-south-1
S3_ENDPOINT_URL=http://seaweedfs:8333
# Presigned URLs are signed for the app's own origin; Caddy forwards /<bucket>/* to storage.
# For cloud S3 set S3_PRESIGN_VIA_APP_ORIGIN=false and leave S3_PUBLIC_ENDPOINT_URL empty.
S3_PRESIGN_VIA_APP_ORIGIN=true
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=drawingops-dev
S3_SECRET_ACCESS_KEY=dev-only-storage-key
S3_SERVER_SIDE_ENCRYPTION=

# Outside production only a local catcher is allowed (Mailpit UI: http://localhost:8025).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=DrawingOps <no-reply@drawingops.local>

# SSO (DEC-02): fill in one provider. Only these email domains may sign in with SSO.
SSO_ALLOWED_DOMAINS=firm.example
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=organizations

SENTRY_DSN=
LOG_LEVEL=INFO
SITE_ADDRESS=:8080
# Host port for Caddy (change if 8080 is taken on your machine).
HTTP_PORT=8080

# F-25 / I-09 inbound client email (p-<project code>@INBOUND_EMAIL_DOMAIN). The mail provider
# POSTs raw MIME to /integrations/inbound-email with X-Inbound-Secret, or set INBOUND_IMAP_*.
INBOUND_EMAIL_DOMAIN=inbound.drawingops.local
INBOUND_EMAIL_SECRET=dev-inbound-secret
INBOUND_IMAP_HOST=
INBOUND_IMAP_USER=
INBOUND_IMAP_PASSWORD=
