# DrawingOps on Railway. Set these as Railway variables (shared across web, worker, beat).
# Never commit real values. Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ENVIRONMENT=production
DJANGO_SECRET_KEY=<generate>
DJANGO_DEBUG=false
# The Railway domain(s) of the web service, plus Railway's health checker.
DJANGO_ALLOWED_HOSTS=YOUR-API.up.railway.app,healthcheck.railway.app
# The browser origin (Vercel domain and any custom domain).
DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR-APP.vercel.app
FRONTEND_URL=https://YOUR-APP.vercel.app
# Browser → Vercel → Railway edge: two proxies append X-Forwarded-For entries.
TRUSTED_PROXY_COUNT=2

# PostgreSQL (Railway plugin: reference ${{Postgres.DATABASE_URL}}). Needs pg_trgm (created by migrations).
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_CONN_MAX_AGE=60

# Upstash Redis: use the TLS URL (rediss://). Broker and cache may share one database.
CELERY_BROKER_URL=rediss://default:<password>@<name>.upstash.io:6379
CACHE_URL=rediss://default:<password>@<name>.upstash.io:6379

# Amazon S3 (bucket in the agreed region; see deploy/aws/*.json and the runbook).
S3_BUCKET=YOUR-BUCKET
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_PRESIGN_VIA_APP_ORIGIN=false
S3_ACCESS_KEY_ID=<IAM user key with deploy/aws/iam-policy.json>
S3_SECRET_ACCESS_KEY=<secret>
S3_SERVER_SIDE_ENCRYPTION=

# SMTP (Django's SMTP backend is the production default).
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=<user>
EMAIL_HOST_PASSWORD=<password>
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=DrawingOps <drawings@your-firm.com>

# SSO (one provider; DEC-02). Redirect URI: https://YOUR-APP.vercel.app/accounts/<provider>/login/callback/
SSO_ALLOWED_DOMAINS=your-firm.com
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=organizations

# Optional
SENTRY_DSN=
LOG_LEVEL=INFO
INBOUND_EMAIL_DOMAIN=inbound.your-firm.com
INBOUND_EMAIL_SECRET=<generate>
# Only if you use the cron tick instead of a beat service:
CRON_SECRET=<generate>
BEAT_STALE_AFTER_MINUTES=11
# Exports above this run in the background (keep requests short behind the Vercel proxy).
EXPORT_SYNC_MAX_ROWS=2000
# gunicorn processes: N-01 (200 users, p95 < 300 ms) measured at 6 processes × 4 threads;
# give the web service ~6 vCPU, or run 2 replicas of 3 (docs/runbooks/deploy-railway-vercel.md).
WEB_CONCURRENCY=6
CELERY_CONCURRENCY=2
